# Copiez ce fichier en ".env" et ajustez les valeurs pour votre environnement.
# Ne committez jamais le fichier ".env" réel (déjà exclu par .gitignore).

# Clé secrète Flask, utilisée pour signer les sessions et les tokens CSRF.
# Générez-en une vraie en production, par exemple avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-moi-en-production

# URI de connexion à la base de données.
# SQLite (par défaut, développement local) :
DATABASE_URL=sqlite:///interventions.db
# PostgreSQL (exemple pour la production) :
# DATABASE_URL=postgresql://user:password@localhost:5432/ocp_interventions

# Active le débogueur Flask (NE JAMAIS activer en production ou en démo publique)
FLASK_DEBUG=0